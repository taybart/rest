{{- /* vim: set ft=gotmpl : */ -}}
// {{.Label}}
async function {{ident .Label}}() {
  const res = await fetch({{jsstr .URL}}, {
    method: {{jsstr .Method}},
{{- if or .Headers .Cookies}}
    headers: {
{{- range $k, $v := .Headers}}
      {{jsstr $k}}: {{jsstr $v}},
{{- end}}
{{- if .Cookies}}
      "Cookie": {{jsstr (cookies .Cookies)}},
{{- end}}
    },
{{- end}}
{{- if .Body}}
{{- if .IsJSON}}
    body: JSON.stringify({{jsonindent "    " .Body}}),
{{- else}}
    body: {{jsstr .Body}},
{{- end}}
{{- end}}
  });
{{- if .Expect.Status}}
  if (res.status !== {{.Expect.Status}}) {
    throw new Error(`expected status {{.Expect.Status}}, got ${res.status}`);
  }
{{- end}}
  return res;
}
