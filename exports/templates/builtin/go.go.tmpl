{{- /* vim: set ft=gotmpl : */ -}}
// {{ident .Label}} : {{.Label}}
func {{ident .Label}}() (*http.Response, error) {
{{- if .Body}}
	body := strings.NewReader({{lit .Body}})
	req, err := http.NewRequest({{lit .Method}}, {{lit .URL}}, body)
{{- else}}
	req, err := http.NewRequest({{lit .Method}}, {{lit .URL}}, nil)
{{- end}}
	if err != nil {
		return nil, err
	}
{{- range $k, $v := .RequestHeaders}}
	req.Header.Set({{lit $k}}, {{lit $v}})
{{- end}}
{{- if eq .Auth.Type "basic"}}
	req.SetBasicAuth({{lit .Auth.User}}, {{lit .Auth.Password}})
{{- else if eq .Auth.Type "bearer"}}
	req.Header.Set("Authorization", {{lit (printf "Bearer %s" .Auth.Token)}})
{{- end}}
{{- if .UserAgent}}
	req.Header.Set("User-Agent", {{lit .UserAgent}})
{{- end}}
{{- range $k, $v := .Cookies}}
	req.AddCookie(&http.Cookie{Name: {{lit $k}}, Value: {{lit $v}}})
{{- end}}
{{- if .Expect.Status}}
	res, err := http.DefaultClient.Do(req)
	if err != nil {
		return nil, err
	}
	if res.StatusCode != {{.Expect.Status}} {
		return res, fmt.Errorf("expected status {{.Expect.Status}}, got %d", res.StatusCode)
	}
	return res, nil
{{- else}}
	return http.DefaultClient.Do(req)
{{- end}}
}
