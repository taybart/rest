{{- /* vim: set ft=gotmpl : */ -}}
# {{.Label}}
curl
{{- if eq .Method "HEAD"}} --head
{{- else if or (ne .Method "GET") .Body}} -X {{.Method}}
{{- end}} {{lit .URL}}
{{- range $k, $v := .RequestHeaders}} \
  -H {{lit (printf "%s: %s" $k $v)}}
{{- end}}
{{- if eq .Auth.Type "basic"}} \
  -u {{lit (printf "%s:%s" .Auth.User .Auth.Password)}}
{{- else if eq .Auth.Type "bearer"}} \
  --oauth2-bearer {{lit .Auth.Token}}
{{- end}}
{{- if .UserAgent}} \
  -A {{lit .UserAgent}}
{{- end}}
{{- with .CookieHeader}} \
  -b {{lit .}}
{{- end}}
{{- if .Body}} \
  --data-raw {{lit .Body}}
{{- end}}
