# from the spec's components.schemas, *_input variants leave out readOnly fields
schemas {
  api_response = {
    code    = is::optional(is.int)
    message = is::optional(is.string)
    type    = is::optional(is.string)
  }
  category = {
    id   = is::optional(is.int)
    name = is::optional(is.string)
  }
  order = {
    complete = is::optional(is.bool)
    id       = is::optional(is.int)
    petId    = is::optional(is.int)
    quantity = is::optional(is.int)
    shipDate = is::optional(is.string)
    status   = is::optional(is("regex:^(placed|approved|delivered)$"))
  }
  pet = {
    category  = is::optional(schemas.category)
    id        = is::optional(is.int)
    name      = is.string
    photoUrls = is::array_of(is.string)
    status    = is::optional(is("regex:^(available|pending|sold)$"))
    tags      = is::optional(is::array_of(schemas.tag))
  }
  tag = {
    id   = is::optional(is.int)
    name = is::optional(is.string)
  }
  user = {
    email      = is::optional(is.string)
    firstName  = is::optional(is.string)
    id         = is::optional(is.int)
    lastName   = is::optional(is.string)
    password   = is::optional(is.string)
    phone      = is::optional(is.string)
    userStatus = is::optional(is.int)
    username   = is::optional(is.string)
  }
}

