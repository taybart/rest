# Server
server {
  address = "localhost:18080"

  kv = {
    db = {
      users = {
        1 = { name = "Bryan Cranston", role = "dad" },
        4 = { name = "Frankie Muniz", role = "middle" },
      },
    }
  }

  # optional one-time lua setup hook on server start:
  setup = <<LUA
    kv.set('boot_time', os.time())
  LUA

  middleware "auth" {
    fn = <<LUA
      local token = rest.req:cookie("token") or rest.req:bearer_token()
      if not uuid.is_uuidv4(token) then
        return {
          status = 401,
          body = json.encode({error = "missing credentials"})
        }
      end
      local last_token = kv.get('last_token')
      if last_token ~= token then
        return {
          status = 401,
          body = json.encode({error = "invalid credentials"})
        }
      end
      rest.ctx.token = token
    LUA
  }

  handler "POST" "/login" {
    fn = <<LUA
      local body = json.decode(rest.req.body)
      if body.username == "root" and body.password == "toor" then
        local token = uuid.newv4()
        kv.set('last_token', token)  -- in memory key value cache
        return {
          status = 200,
          cookies = {
            token = {
              value = token,
              path = "/",
              http_only = true,
              same_site = "strict",
              secure = true,
            },
          },
          body = json.encode({token = token})
        }
      end
      return {
        status = 401,
        body = json.encode({error = "invalid credentials"})
      }
    LUA
  }
  handler "GET" "/user/{id}" {
    middleware = ["auth"]
    fn         = <<LUA
      print('GOT COOKIE: '..inspect(rest.req.cookies))
      -- get id from path
      local id = rest.req:path_value("id")
      local q = rest.req:query("q")
      print('q: '..q)
      local db = kv.get("db")
      local user = db.users[id]
      if not user then
        return {
          status = 404,
          body = json.encode({ error = "user not found" })
        }
      end
      return {
        status = 200,
        body = json.encode({ id = id, name = user.name, role = user.role })
      }
    LUA
  }
}


## Test Client
request "login" {
  url    = "http://localhost:18080/login"
  method = "POST"
  body   = { "username" : "root", "password" : "toor" }
  expect { status = 200 body = { token = is.uuidv4 } }
  after = [
    lib.expected,
    export_res({ auth_token = "token" }),
  ]
}

request "get user" {
  url   = "http://localhost:18080/user/4"
  query = { q = "fran" }
  # cookie will come along if this is the second request block after "login" so 
  # we don't actually need to include the token as a bearer token
  # bearer_token = exports.auth_token
  expect = 200
  after  = [lib.print_label, lib.inspect_res]
}
