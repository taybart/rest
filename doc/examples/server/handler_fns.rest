# Server
server {
  address = "localhost:18080"

  middleware "auth" {
    fn = <<LUA
      local token = rest.req:cookie("token") or rest.req:bearer_token()
      if not uuid.is_uuidv4(token) then
        return {
          status = 401,
          body = json.encode({error = "missing credentials"})
        }
      end
      local last_token = kv.get('last_token')
      if last_token ~= token then
        return {
          status = 401,
          body = json.encode({error = "invalid credentials"})
        }
      end
      rest.ctx.token = token
    LUA
  }

  handler "POST" "/login" {
    fn = <<LUA
      local body = json.decode(rest.req.body)
      if body.username == "root" and body.password == "toor" then
        local token = uuid.newv4()
        kv.set('last_token', token)  -- in memory key value cache
        return {
          status = 200,
          cookies = {
            token = {
              value = token,
              path = "/",
              http_only = true,
              same_site = "strict",
              secure = true,
            },
          },
          body = json.encode({token = token})
        }
      end
      return {
        status = 401,
        body = json.encode({error = "invalid credentials"})
      }
    LUA
  }
  handler "GET" "/user/{id}" {
    middleware = ["auth"]
    fn = <<LUA
      print('GOT COOKIE: '..inspect(rest.req.cookies))
      -- get id from path
      local id = rest.req:path_value("id")
      local q = rest.req:query("q")
      print('q: '..q)
      return {
        status = 200,
        body = json.encode({ id = id, name = "Frankie Muniz" })
      }
    LUA
  }
}


## Test Client
request "get auth token" {
  url    = "http://localhost:18080/login"
  method = "POST"
  body   = { "username" : "root", "password" : "toor" }
  # expect {
  #   status = 200
  #   body   = json_enc({ token = "{{uuidv4}}" })
  # }
  after = <<LUA
    print('==='..rest.label..'===')
    if not tools.expected() then
      return
    end
    print(("COOKIE-CRISP %s"):format(inspect(rest.res.cookies)))
    print(rest.res.body)
    local body = json.decode(rest.res.body)
    if not body.token  then
      fail('no auth_token returned')
      return
    end
    rest.exports.auth_token = body.token
    print('got new auth_token: '..rest.exports.auth_token)
  LUA
}

request "get user" {
  url          = "http://localhost:18080/user/5"
  query        = { q = "fran" }
  bearer_token = exports.auth_token
  after        = <<LUA
    print('\n==='..rest.label..'===')
    inspect.print(json.decode(rest.res.body))
  LUA
}
request "get unknown" {
  url          = "http://localhost:18080/idk"
  bearer_token = exports.auth_token
  after        = <<LUA
    print('\n==='..rest.label..'===')
    print(rest.res.dump)
  LUA
}
